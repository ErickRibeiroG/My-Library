# Copie para `.env` e ajuste. Todas as variáveis são opcionais em desenvolvimento.

# Obrigatória quando DJANGO_DEBUG=False. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção atrás de HTTPS, ex.: https://meusite.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Caminho alternativo para o banco SQLite (padrão: db.sqlite3 na raiz do projeto)
DJANGO_DB_PATH=

# Recomendado: sem chave, o Google Books limita as requisições (HTTP 429) e a
# busca passa a usar a Open Library automaticamente.
# Crie em https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Tempo (s) que um resultado de busca fica em cache e timeout das APIs
BUSCA_CACHE_SEGUNDOS=3600
BUSCA_TIMEOUT_SEGUNDOS=6
